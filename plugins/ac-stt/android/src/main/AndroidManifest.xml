<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Micro pour la dictée vocale — mergé dans le manifest de l'app
         par le manifest merger gradle. Le grant runtime passe par
         @TauriPlugin(permissions = …) dans SttPlugin.kt. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Download des modèles (settings « Reconnaissance vocale ») —
         INTERNET vient déjà du manifest de l'app générée ; le déclarer
         ici rend la dépendance explicite (le merger déduplique). -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
